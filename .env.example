# easy-ig configuration. Copy to .env and fill in.
#
# IMPORTANT — quoting: values are read with godotenv, which expands $VAR in
# UNQUOTED values. Anything containing a dollar sign (notably a bcrypt hash)
# must be wrapped in SINGLE QUOTES, or characters are silently eaten and the
# value no longer works. `go run ./cmd/dashboard-hash` prints correctly
# quoted lines — paste them verbatim.

PORT=8211

# ---- upstream proxy ------------------------------------------------------
# Bright Data proxy. Note the cert and the port are strictly paired; the
# legacy certificate retires 2026-09-25, after which port 44445 is required.
PROXY='http://brd-customer-XXXX-zone-YYYY:PASSWORD@brd.superproxy.io:44445'
PROXY_FALLBACK='http://brd-customer-XXXX-zone-ZZZZ:PASSWORD@brd.superproxy.io:44445'
# LOCAL_PROXY=http://localhost:8886/

# ---- RapidAPI gate -------------------------------------------------------
# When set, every API route requires the X-RapidAPI-Proxy-Secret header.
# The dashboard is deliberately exempt — browsers cannot send it.
RAPIDAPI_PROXY_SECRET=

# ---- request logging -----------------------------------------------------
# Off by default so an existing deployment is unchanged until it opts in.
REQLOG_ENABLED=false

# SQLite file. On a server, put this on the data volume rather than the root
# disk, e.g. /mnt/storage/easy-ig/reqlog.db
REQLOG_DB=logs/reqlog.db

# Sliding retention window in days. 0 keeps everything forever. Changing it
# from the dashboard overrides this value and persists in the database, so
# this only sets the initial default.
REQLOG_RETENTION_DAYS=14

# When to keep response bodies:
#   none    never
#   errors  only when the status is 400 or above  (default)
#   all     every response
#
# 'errors' is the default on purpose. /username-with-base64-image and
# /get-post-with-base64-image embed base64 images, so one successful response
# can be megabytes — and gzip barely helps, since the underlying JPEG is
# already compressed. Those bodies also contain personal data of the
# Instagram accounts looked up, which is worth storing only when there is a
# reason to. Bodies are gzip-compressed and capped either way.
REQLOG_CAPTURE=errors
REQLOG_MAX_BODY_BYTES=32768

# Request headers and body are captured under the same setting, with
# credential-bearing headers redacted by key: X-RapidAPI-Proxy-Secret,
# Authorization, Cookie, Proxy-Authorization, X-API-Key. The key stays
# visible, the value never lands in the database.
#
# With capture=all, successful response bodies are stored too — that is the
# setting to use when you want the full round trip on the dashboard. Bear in
# mind those bodies contain the profile data of the Instagram accounts looked
# up, so the retention window above is also how long that personal data is
# kept.

# Async write buffer. Logging is deliberately lossy: when this fills, entries
# are dropped rather than slowing the API down. The dashboard shows the drop
# count — a large number means raise this.
REQLOG_QUEUE_SIZE=1024

# ---- dashboard -----------------------------------------------------------
# Generate the three values below with:
#   go run ./cmd/dashboard-hash
#
# The password is never stored — only its bcrypt hash. Keep the single quotes.
DASHBOARD_PREFIX=/logs
DASHBOARD_USER=admin
DASHBOARD_PASSWORD_HASH=''

# Signs session cookies. Keep it stable, or every restart logs everyone out.
# Leaving it empty generates a random one at startup, which is secure but has
# exactly that effect.
DASHBOARD_SESSION_SECRET=''
